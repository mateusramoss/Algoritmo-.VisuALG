Algoritmo "semnome"
var
  R: caracter
  C_quant, C, F: inteiro
Quant_alu, V, Aprov, Recup, Reprov, Cont_ver: inteiro
  Nota, S, M, M_geral, S_media: real
inicio
  escreval("Quantos alunos serão? ")
    leia(F)
  C <- 1
  repita
    para C_quant de 1 ate F passo 1 faca
      enquanto (C <= 3) faca
        escreval("Digite a nota")
          leia(Nota)
       se (Nota >= 0) e (Nota <=10) entao
          S <- S + Nota
          V <- 1
        senao
          C <- 4
          V <- 0
        fimse
        C <- C + 1
      fimenquanto
      se (V = 1) entao
        limpatela
      se (C_quant < F) entao
        escreval("Próximo aluno: ")
      fimse
        M <- S / 3
        S_media <- S_media + M
        se (M >= 7) entao
          Aprov <- Aprov + 1
        senao
          se (M >= 5) e (M < 7) entao
            Recup <- Recup + 1
          senao
            Reprov <- Reprov + 1
          fimse
        fimse
        S <- 0
      senao
        escreval("VALOR INCONGRUENTE COM O PROPÓSITO DO PROGRAMA.")
        C_Quant <- Quant_alu
        escreval("Quer continuar?[S/N]")
        leia(R)
        limpatela
        C_quant <- 1
        C <- 1
        Cont_ver <- 1
      fimse
      se (C_quant < F) entao
        C <- 1
      fimse
    fimpara
    se (C_quant = F) e (Nota >= 0) entao
      R <- "N"
    fimse
  ate (R = "N")
Fimalgoritmo
