algoritmo

var
  R, C: inteiro
inicio
  escreval("-------------------")
  escreval("|      MENU       |")
  escreval("-------------------")
  escreval("|  [1] De 1 a 10  |")  
  escreval("|  [2] De 10 a 1  |")
  escreval("|  [3] Sair       |")
  escreval("-------------------")
    leia(R) 
  se (R = 1) entao
    C <- 1
    repita
      escreva(C, " ")
      C <- C + 1
    ate (C > 10)
  senao
    C <- 10
    se (R = 2) entao
      repita
        escreva(C, " ")
        C <- C - 1
      ate (C < 1)
    senao
      escreval("Programa encerrado.")
    fimse
  fimse
fimalgoritmo