algoritmo 

var
  R: caracter
  saque, C_100, C_50, C_20, C_10, C_5, C_2, V, Q_saq, T, C_V: inteiro
inicio
  repita
    escreva("Digite um valor para saque. Evite pressionar 1 ao final do número. Caso contrário, dará erro. ")
      leia(saque)
      escreval(saque)
//--------------------------------------------------------
    se (saque < 0) ou (saque = 0) ou (saque = 1) entao
      se (saque = 1) entao
        escreval("Não é possível sacar R$1,00")
        C_V <- 1
      senao
        escreval("ERRO! VALOR DIGITADO NÃO PODE SER SACADO.")
      fimse
      escreval("Quer continuar? [S/N]")
        leia(R)
        V <- 1
      se (R = "S") entao
        V <- 0
        C_V <- 0
      fimse
//--------------------------------------------------------
    senao
      se (saque >= 100) entao
        repita
            saque <- saque - 100
            C_100 <- C_100 + 1
        ate (saque < 100)
      fimse
      se (saque >= 50) entao
        repita
          saque <- saque - 50
          C_50 <- C_50 + 1
        ate (saque < 50)
      fimse
      se (saque >= 20) entao
        repita
          saque <- saque - 20
          C_20 <- C_20 + 1
        ate (saque < 20)
      fimse
      se (saque >= 10) entao
        repita
          saque <- saque - 10
          C_10 <- C_10 + 1
        ate (saque < 10)
      fimse
      se (saque >= 5) entao
        repita
          saque <- saque - 5
          C_5 <- C_5 + 1
        ate (saque < 5)
      fimse
      se (saque >= 2) entao
        repita 
          saque <- saque - 2
          C_2 <- C_2 + 1
        ate (saque < 2)
      fimse
      se (V = 0) entao
        escreval("Quer continuar? [S/N]")
          leia(R)
      fimse
//----------------------------------------
      se(saque = 1) e (C_V = 0) entao
        T <- saque
      fimse
//----------------------------------------
        Q_saq <- Q_saq + 1
    fimse
//--------------------------------------------------------
  ate (R = "N")
  se (V = 0) ou (saque <= 1) entao
    escreval("De 100: ", C_100)
    escreval("De 50: ", C_50)
    escreval("De 20: ", C_20)
    escreval("De 10: ", C_10)
    escreval("De 5: ", C_5)
    escreval("De 2: ", C_2)
    escreval("Foram feitos ", Q_saq, " saque da conta.")
    se (T = 1) entao
      escreval("Você ficou com saldo de  R$1,00 em sua conta.")
    fimse
  fimse
fimalgoritmo