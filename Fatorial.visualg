algoritmo "Primeiro Programa"

var
  R: caracter
  N, C: real
inicio
  repita  
    escreval("Digite um número")
    leia(N)
    C <- N - 1
    repita
      N <- N * C
      C <- C - 1
    ate (C < 1)
    escreval(N)
    escreval("Quer continuar? [S/N]")
      leia(R)
    limpatela
  ate (R = "N")
fimalgoritmo
 