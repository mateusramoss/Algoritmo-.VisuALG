algoritmo
var
   Num_F, Num_i, pulos: real
inicio
escreval("--------CONTADOR-------")
  escreval("Digite o número inicial")
   leia(Num_i)
  escreval("Até qual número deseja que seja contado? ")
   leia(Num_F)
  escreval("Qual a frequência de pulos? ")
    leia(pulos)
  se (Num_i <= Num_F) entao
    repita
      escreva(Num_i, "... ")
      Num_i <- Num_i + pulos
    ate (Num_i > Num_F)
  senao
    repita
      escreva(Num_i, "... ")
      Num_i <- Num_i - pulos
    ate (Num_i < Num_F)
  fimse
fimalgoritmo
algoritmo

var
  Num_F, Num_i, pulos: real
inicio
  escreval("--------CONTADOR-------")
  escreval("Digite o número inicial")
  leia(Num_i)
  escreval("Até qual número deseja que seja contado? ")
  leia(Num_F)
  escreval("Qual a frequência de pulos quer que seja usado? ")
  leia(pulos)
  se (Num_i <= Num_F) entao
    enquanto (Num_i <= Num_F) faca
      escreva("  ", Num_i, "...")
      Num_i <- Num_i + pulos
    fimenquanto
  senao
    enquanto (Num_i >= Num_F) faca
      escreva("  ", Num_i, "...")
      Num_i <- Num_i - pulos
    fimenquanto
  fimse
fimalgoritmo