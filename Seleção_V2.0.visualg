algoritmo 

var

  Sx, R: caracter
  Ida, Cor, C_M, C_F, Ver, V_Sx, V_Cor: inteiro

inicio

  escreval("--------------------")
  escreval(" SELETOR DE PESSOAS ")
  escreval("--------------------")
//------------------------------------------------------------------
repita
    repita
      escreval("Qual o sexo? [M/F]")
      leia(Sx)
      se (Sx = "M") ou (Sx = "F") entao
      V_Sx <- 1
      senao
        V_Sx <- 0
        limpatela
        escreval("ERRO! CARACTER INVÁLIDO. ")
      fimse
    ate (V_Sx = 1)
//------------------------------------------------------------------
      escreval("Qual a idade? ")
      leia(Ida)
//------------------------------------------------------------------
    repita
      escreval("Qual a cor do cabelo?")
      escreval("---------------------")
      escreval("[1] Castanho")
      escreval("[2] Loiro")
      escreval("[3] Preto")
      escreval("[4] Ruivo")
      leia(Cor) 
      se (Cor <> 1) e (Cor <> 2) e (Cor <> 3) e (Cor <> 4) entao
        V_Cor <- 0
        limpatela
        escreval("ERRO! OPÇÃO INVÁLIDA. ")
      senao
        V_Cor <- 1
      fimse  
    ate (V_Cor = 1)   
//------------------------------------------------------------------
    se (Sx = "M") e (Ida >= 18) e (Cor = 1) entao
      C_M <- C_M + 1
    senao
      se (Sx = "F") e (Ida >= 25) e (Ida <= 30) e (Cor = 2) entao
        C_F <- C_F + 1
      fimse
    fimse
    escreval("Quer continuar? [S/N]")
    leia(R)
    limpatela
ate (R = "N")
//------------------------------------------------------------------
  escreval("Há ", C_M, " Machos com igual ou mais de dezoito ano(s) e que têm cabelo castanho. E há ", C_F, " Fêmeas, com idade(s) entre vinte cinc e trinta anos, e têm cabelo loiro")

fimalgoritmo
