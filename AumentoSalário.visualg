algoritmo

var
  nome: caracter
  sal, Nsal: real
  dep: inteiro
inicio
  escreval("Qual o nome do(a) funcionário(a)? ")
    leia(nome)
  escreval("Qual o salário dele(a)? ")
    leia(sal)
  escreval("Quantos dependentes ele(a) tem? ")
    leia(dep)
  escolha  dep
    caso 0 
      Nsal <- sal + (sal * 5 / 100)
    caso 1, 2, 3
      Nsal <- sal + (sal * 10 / 100)
    caso 4, 5, 6
      Nsal <- sal + (sal * 15 / 100)
    outrocaso
      Nsal <- sal + (sal * 18 / 100)
  fimescolha
  escreval("O novo salário de ", nome, " será de R$", Nsal:5:2)
fimalgoritmo
